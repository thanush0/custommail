# Generate unique values. Never commit the real .env file.
APP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
APP_BASE_URL=https://YOUR-INSTABOX-PUBLISHED-URL
COOKIE_SECURE=true
ADMIN_USERNAME=thanush0
ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
MAIL_DOMAIN=mailus.aclclouds.online
DATABASE_URL=postgresql+psycopg://custommail:REPLACE_PASSWORD@db:5432/custommail
POSTGRES_DB=custommail
POSTGRES_USER=custommail
POSTGRES_PASSWORD=REPLACE_PASSWORD
POSTGRES_DATA=/data/custommail/postgres
MAILBOX_QUOTA_MB=500
SESSION_MAX_AGE_SECONDS=3600
REGISTRATION_ENABLED=true
STORAGE_DIR=/data/custommail
MAX_ATTACHMENT_MB=10
BOOTSTRAP_ADMIN_ENABLED=true

# Leave blank until InstaBox SMTP connectivity and DNS are verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Mailumi integration — configure using your private secret manager
MAILUMI_API_KEY=
MAILUMI_SEND_API_KEY=
MAILUMI_WEBHOOK_SECRET=
